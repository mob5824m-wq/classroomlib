<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd agent: auto-starts the Classroom Library Node server when you
  log in and keeps it running (restarts it if it crashes).

  SETUP: run deploy/setup-mac.sh — it fills in __REPO__/__NODE__ for you and
  installs this into ~/Library/LaunchAgents/. You normally don't edit this
  file by hand.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.classroom-library.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>server.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/classroom-library.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/classroom-library.err.log</string>
</dict>
</plist>
