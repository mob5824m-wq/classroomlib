<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd agent: runs the DuckDNS updater every 5 minutes so your
  myroomlibrary.duckdns.org always points at your current home IP.

  Before enabling this, fill in your domain + token:
      cp deploy/duckdns.conf.example deploy/duckdns.conf   (edit it)
  then run deploy/setup-mac.sh, which fills in the repo path, installs and
  loads this agent.

  See the log at /tmp/classroom-library-duckdns.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.classroom-library.duckdns</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/deploy/duckdns-update.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/classroom-library-duckdns.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/classroom-library-duckdns.err.log</string>
</dict>
</plist>
